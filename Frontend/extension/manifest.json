{
  "manifest_version": 3,

  "name": "VoxReview",
  "version": "1.0.0",

  "description": "AI-powered review analysis extension",

  "action": {
    "default_title": "VoxReview",
    "default_popup": "popup.html"
  },

  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.shopee.ph/*",
        "https://*.shopee.com/*",
        "https://*.shopee.co.id/*",
        "https://*.shopee.com.my/*",
        "https://*.shopee.sg/*",
        "https://*.shopee.tw/*",
        "https://*.shopee.vn/*"
      ],
      "js": [
        "scraper/detector.js",
        "scraper/platforms/shopee.js",
        "scraper/scraperManager.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.lazada.com.ph/*",
        "https://*.lazada.com/*",
        "https://*.lazada.co.id/*",
        "https://*.lazada.com.my/*",
        "https://*.lazada.sg/*",
        "https://*.lazada.vn/*"
      ],
      "js": [
        "scraper/detector.js",
        "scraper/platforms/lazada.js",
        "scraper/scraperManager.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://maps.google.com/*",
        "https://*.google.com/maps/*",
        "https://*.google.com.ph/maps/*",
        "https://maps.google.com.ph/*"
      ],
      "js": [
        "scraper/detector.js",
        "scraper/platforms/google.js",
        "scraper/scraperManager.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://play.google.com/*"
      ],
      "js": [
        "scraper/detector.js",
        "scraper/platforms/googleplay.js",
        "scraper/scraperManager.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "scraper/detector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}